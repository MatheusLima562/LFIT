# Copie para .env.local (nunca commite o .env.local).

# Supabase — Project Settings → API Keys (use as chaves NOVAS, não as legadas anon/service_role JWT)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key: SOMENTE no servidor. Nunca use prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# URL pública do app (links de convite/recuperação).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Criação de conta pública desligada: trainers entram só por convite do owner.
ALLOW_PUBLIC_SIGNUP=false

# Testes de banco criam e apagam dados. Só ligue em projeto de DESENVOLVIMENTO.
ALLOW_DB_TESTS=false

# Senha dos usuários fictícios criados por `npm run db:seed`.
SEED_USER_PASSWORD=
