# Copie para .env.local (nunca commite o .env.local).

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<anon/publishable key>
# service_role: SOMENTE no servidor. Nunca use prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=<service_role/secret key>

# URL pública do app (links de convite/recuperação).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Criação de conta pública desligada: trainers entram só por convite do owner.
ALLOW_PUBLIC_SIGNUP=false

# Testes de banco criam e apagam dados. Só ligue em projeto de DESENVOLVIMENTO.
ALLOW_DB_TESTS=false

# Senha dos usuários fictícios criados por `npm run db:seed`.
SEED_USER_PASSWORD=
